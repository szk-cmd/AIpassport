# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริงเอง (.env.local จะไม่ถูก commit)

# Supabase — ใช้ได้ทั้งฝั่ง browser และ server
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — ห้ามใส่ NEXT_PUBLIC_ ข้างหน้าเด็ดขาด
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# AI ที่ใช้ (lib/ai.ts): mock | gemini | anthropic
# mock หรือไม่มี key ของตัวที่เลือก = ใช้ข้อมูลจำลอง ไม่เรียก API จริง
AI_PROVIDER=mock

# Gemini — ขอ key ฟรีที่ https://aistudio.google.com/apikey
GEMINI_API_KEY=
# เว้นว่าง = gemini-3.8-flash
GEMINI_MODEL=
