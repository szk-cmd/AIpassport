# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริงเอง (.env.local จะไม่ถูก commit)
# บน Vercel: ใส่ทุกตัวที่ Project → Settings → Environment Variables (ไม่ต้องใส่ตัวที่เว้นว่างได้)
# ตัวที่ขึ้นต้น NEXT_PUBLIC_ เท่านั้นที่ไปถึง browser ได้ ตัวอื่นอยู่ฝั่ง server เท่านั้น

# ---------- Supabase (จำเป็น) ----------
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — ห้ามใส่ NEXT_PUBLIC_ ข้างหน้าเด็ดขาด
SUPABASE_SERVICE_ROLE_KEY=

# ---------- AI (lib/ai.ts) ----------
# mock | gemini | anthropic — mock หรือไม่มี key ของตัวที่เลือก = ใช้ข้อมูลจำลอง ไม่เรียก API จริง
AI_PROVIDER=mock

# Gemini — ขอ key ฟรีที่ https://aistudio.google.com/apikey (server-only)
GEMINI_API_KEY=
# เว้นว่าง = gemini-3.8-flash
GEMINI_MODEL=
# รุ่นสำรองเมื่อรุ่นหลักคนใช้เยอะ เว้นว่าง = gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=

# Anthropic — ใช้เมื่อ AI_PROVIDER=anthropic (server-only)
ANTHROPIC_API_KEY=
# เว้นว่าง = claude-opus-5-5
ANTHROPIC_MODEL=
